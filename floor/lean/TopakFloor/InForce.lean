import Cedar.Thm.Validation
import TopakFloor.EmergencyTests
import TopakFloor.Gates
/-!
# The floor in force under Cedar's verified semantics

The reference links, pins and replays the `emergency` stage of the proposed floor (`floor/proposed/emergency-floor.cedar`
and `emergency.cedarschema`; `mechanism/crates/topak-floor/src/lib.rs`, `PINNED_FLOOR_SHA256`), not the genesis floor
`Gates.lean` states. This file proves of the floor in force what `Gates.lean` proves of the genesis floor
(ADR-0053 finding 6): the totality gate as one theorem of cedar-spec's proved validator soundness, the stage's 107
behavioural cases under the model's authorizer (`EmergencyTests.lean`), and witnesses for non-vacuity and
discrimination on each of its sixteen actions, with no exception.

The statement is generated by `gen.py emergency` from the files the reference pins, whose digests the generated header
prints; it rests on what `Gates.lean` rests on (the kernel, cedar-spec's model and T-0045-3, the cedar CLI's parse,
`native_decide`). The floor in force is genesis-provisional (ADR-0030 A3): proved here is what its text means under the
model, not that it is fit.
-/

namespace TopakFloor
open Cedar.Spec Cedar.Validation Cedar.Thm Cedar.Data

/-- Schema S of the floor in force is well-formed. -/
theorem inForce_schema_wf : emergencySchema.validateWellFormed = .ok () :=
  schemaWellFormed_ok (by native_decide)

/-- The floor in force validates against its S. -/
theorem inForce_validates : validate emergencyFloor emergencySchema = .ok () :=
  validates_ok (by native_decide)

/-- Totality (ADR-0030 §5) of the floor in force: on every schema-conforming request and store, each of its 28 policies
evaluates to a boolean or to a runtime error the validator cannot exclude. The `emergency` gate run's 41 totality
`holds°` rows, as one theorem of the verified model. -/
theorem inForce_never_errors (request : Request) (entities : Entities)
    (hr : validateRequest emergencySchema request = .ok ())
    (he : validateEntities emergencySchema entities = .ok ()) :
    AllEvaluateToBool emergencyFloor request entities :=
  validation_is_sound emergencyFloor emergencySchema request entities inForce_schema_wf inForce_validates hr he

/-- The floor in force calls no extension and does no arithmetic, so of the three residual errors only
`entityDoesNotExist` can occur, a lift fault (ADR-0030 §4). -/
theorem inForce_no_ext_no_arith : emergencyFloor.all (fun p => noExtNoArith p.toExpr) = true := by native_decide

/-- The sixteen actions of the floor in force: Build's six, Run's three, `Erase`, and the operator's six. -/
def inForceActions : List String :=
  ["Read", "Draft", "Invoke", "Emit", "Submit", "Vote", "Consult", "Actuate", "Report", "Erase",
   "Regrant", "Renew", "AttestGates", "EndRound", "Revoke", "FenceEpoch"]

/-- Every case's request validates against S, and the shared store validates against S. -/
theorem inForce_cases_conform :
    (emCaseRequests.all (fun r => match validateRequest emergencySchema r with | .ok () => true | .error _ => false)) = true ∧
    (match validateEntities emergencySchema emergencyEntities with | .ok () => true | .error _ => false) = true := by
  constructor <;> native_decide

/-- Non-vacuity: for every action, some conforming case is denied. -/
theorem inForce_not_always_allows :
    inForceActions.all (fun a => emCaseRequests.any (fun r =>
      r.action == act a && (isAuthorized r emergencyEntities emergencyFloor).decision == .deny)) = true := by
  native_decide

/-- Discrimination: for every action, some conforming case is allowed. No exception: `Erase` has an allowed case in
the stage's cases, which the genesis cases did not have. -/
theorem inForce_not_always_denies :
    inForceActions.all (fun a => emCaseRequests.any (fun r =>
      r.action == act a && (isAuthorized r emergencyEntities emergencyFloor).decision == .allow)) = true := by
  native_decide

#print axioms inForce_never_errors
#print axioms inForce_validates
#print axioms inForce_not_always_allows
#print axioms inForce_not_always_denies

end TopakFloor
