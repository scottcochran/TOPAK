    actionScope := (.actionInAny [(act "Regrant"), (act "Renew"), (act "AttestGates")]),
    resourceScope := (.resourceScope .any),
    condition := [{ kind := .when, body := (.or (.unaryApp .not (.getAttr (.var .context) "hasLease")) (.unaryApp .not (.getAttr (.var .context) "peerLive"))) }] },
  { id := "C6-no-self", effect := .forbid,
    principalScope := (.principalScope .any),
    actionScope := (.actionInAny [(act "Regrant"), (act "Renew")]),
    resourceScope := (.resourceScope .any),
    condition := [{ kind := .when, body := (.binaryApp .eq (.var .resource) (.var .principal)) }] },
  { id := "C7-fence-needs-lease", effect := .forbid,
    principalScope := (.principalScope .any),
    actionScope := (.actionScope (.eq (act "FenceEpoch"))),
    resourceScope := (.resourceScope .any),
    condition := [{ kind := .when, body := (.unaryApp .not (.getAttr (.var .context) "hasLease")) }] },
  { id := "C8-task-label-in-bounds", effect := .forbid,
    principalScope := (.principalScope .any),
    actionScope := (.actionScope (.eq (act "Regrant"))),
    resourceScope := (.resourceScope .any),
    condition := [{ kind := .when, body := (.or (.unaryApp .not (.getAttr (.var .context) "taskLabelled")) (.unaryApp .not (.binaryApp .containsAll (.getAttr (.var .context) "taskLabelsAllowed") (.getAttr (.var .context) "taskLabel")))) }] },
  { id := "C9-stop-in-own-domain", effect := .forbid,
    principalScope := (.principalScope .any),
    actionScope := (.actionInAny [(act "EndRound"), (act "Revoke")]),
    resourceScope := (.resourceScope .any),
    condition := [{ kind := .when, body := (.unaryApp .not (.binaryApp .eq (.getAttr (.var .resource) "domain") (.getAttr (.var .principal) "domain"))) }] }]

/-- The policy ids, in file order. -/
def emergencyIds : List PolicyID := emergencyFloor.map Policy.id

end TopakFloor
