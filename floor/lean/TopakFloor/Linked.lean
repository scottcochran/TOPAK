import Cedar.Thm.Validation
import TopakFloor.WorkflowTests
import TopakFloor.Gates
/-!
# The floor the reference links under Cedar's verified semantics

Since 2026.10.08 the reference links, pins and replays the `workflow` stage of the proposed floor
(`floor/proposed/workflow-floor.cedar` and `workflow.cedarschema`; `mechanism/crates/topak-floor/src/lib.rs`,
`PINNED_FLOOR_SHA256`; ADR-0033 A16). It is not the floor in force: that is still the `emergency` stage, which
`InForce.lean` states, because ADR-0054, whose `Route`, `R8`, `R9` and widened `R3` the stage adds, is Proposed. This
file proves of the linked floor what `InForce.lean` proves of the floor in force: the totality gate as one theorem of
cedar-spec's proved validator soundness, the stage's 123 behavioural cases under the model's authorizer
(`WorkflowTests.lean`), and witnesses for non-vacuity and discrimination on each of its seventeen actions.

The statement is generated by `gen.py workflow` from the files the reference pins, whose digests the generated header
prints, and rests on what `InForce.lean` rests on.
-/

namespace TopakFloor
open Cedar.Spec Cedar.Validation Cedar.Thm Cedar.Data

/-- Schema S of the linked floor is well-formed. -/
theorem linked_schema_wf : workflowSchema.validateWellFormed = .ok () :=
  schemaWellFormed_ok (by native_decide)

/-- The linked floor validates against its S. -/
theorem linked_validates : validate workflowFloor workflowSchema = .ok () :=
  validates_ok (by native_decide)

/-- Totality (ADR-0030 §5) of the linked floor: on every schema-conforming request and store, each of its 30 policies
evaluates to a boolean or to a runtime error the validator cannot exclude. The `workflow` gate run's totality rows, as
one theorem of the verified model. -/
theorem linked_never_errors (request : Request) (entities : Entities)
    (hr : validateRequest workflowSchema request = .ok ())
    (he : validateEntities workflowSchema entities = .ok ()) :
    AllEvaluateToBool workflowFloor request entities :=
  validation_is_sound workflowFloor workflowSchema request entities linked_schema_wf linked_validates hr he

/-- The linked floor calls no extension and does no arithmetic, so of the three residual errors only
`entityDoesNotExist` can occur, a lift fault (ADR-0030 §4). -/
theorem linked_no_ext_no_arith : workflowFloor.all (fun p => noExtNoArith p.toExpr) = true := by native_decide

/-- The seventeen actions of the linked floor: those of the floor in force, and `Route` (ADR-0040 A2, pending). -/
def linkedActions : List String :=
  ["Read", "Draft", "Invoke", "Emit", "Submit", "Vote", "Consult", "Actuate", "Report", "Route", "Erase",
   "Regrant", "Renew", "AttestGates", "EndRound", "Revoke", "FenceEpoch"]

/-- Every case's request validates against S, and the shared store validates against S. -/
theorem linked_cases_conform :
    (wfCaseRequests.all (fun r => match validateRequest workflowSchema r with | .ok () => true | .error _ => false)) = true ∧
    (match validateEntities workflowSchema workflowEntities with | .ok () => true | .error _ => false) = true := by
  constructor <;> native_decide

/-- Non-vacuity: for every action, some conforming case is denied. -/
theorem linked_not_always_allows :
    linkedActions.all (fun a => wfCaseRequests.any (fun r =>
      r.action == act a && (isAuthorized r workflowEntities workflowFloor).decision == .deny)) = true := by
  native_decide

/-- Discrimination: for every action, some conforming case is allowed. -/
theorem linked_not_always_denies :
    linkedActions.all (fun a => wfCaseRequests.any (fun r =>
      r.action == act a && (isAuthorized r workflowEntities workflowFloor).decision == .allow)) = true := by
  native_decide

#print axioms linked_never_errors
#print axioms linked_validates
#print axioms linked_not_always_allows
#print axioms linked_not_always_denies

end TopakFloor
