# TLA+ tooling. tools/ is tracked: the wrappers, the installer, the verification scripts and tla2tools.jar
# (since 756b481, for its digest: ADR-0045 T-0045-29). The static cvc5 build the floor gates use is not.
tools/cvc5-*/
# The proof checker build (tools/install-ethos.sh): its binary digest is printed in the gate header.
tools/ethos-*/
# The TLAPS release (tools/install-tlaps.sh): its binary digest is printed in the proof results header.
tools/tlaps-*/
.tlacache/
spec/*.cfg
spec/Trace_*.tla
spec/states/
*.toolbox/
# Lake's build directory for the Lean proof of the admit composition (mechanism/lean/results.sh rebuilds it)
mechanism/lean/.lake/
spec/lean/.lake/
floor/lean/.lake/

# Reference material: not ours to redistribute
doc/
*.pdf

# Transport containers — their contents are extracted and tracked at corpus paths
*.zip

# exclude chat sessions
cloud.ai.exports/
sessions/

.DS_Store
